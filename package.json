{
  "name": "portal-cliente-fgx",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "build": "npm run build:api && tsc -b && vite build",
    "build:api": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=api/bundle.mjs --packages=external",
    "preview": "vite preview",
    "db:migrate": "supabase migration up",
    "db:seed": "tsx supabase/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "esbuild": "^0.25.0",
    "hono": "^4.13.0",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.0.0"
  }
}
