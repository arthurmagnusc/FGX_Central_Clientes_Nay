{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/[...route].js": {
      "includeFiles": "lib/api-bundle.mjs",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/health" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
